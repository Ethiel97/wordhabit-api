# Server configuration. Copy to .env and fill in; .env is gitignored.
#
# Production values live in Fly secrets, not here:
#   fly secrets set KEY="value" -a wordhabit-api
#   fly secrets list -a wordhabit-api

# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Postgres. The Fly value points at the internal .flycast address, which
# resolves only from inside the private network.
DATABASE_URL=postgresql://user:password@localhost:5432/wordhabit

# Max connections a single process may open. The Postgres role's cap is
# shared by every process at once — web, worker, both sides of a rolling
# deploy, and the migration release command — so size this as
# cap ≥ (web + worker machines) × 2 × DATABASE_POOL_MAX + ~3.
# See docs/database-connections.md. Defaults to 5.
DATABASE_POOL_MAX=

# ── Auth ────────────────────────────────────────────────────────────

# Read with getOrThrow: the API refuses to boot without it rather than
# signing tokens with a default nobody chose.
JWT_SECRET=change-me

# Audiences accepted on a social identity token, comma separated. One
# entry per bundle id, because each flavour is a distinct client to
# Apple and Google — a token minted for .dev is not valid for prod.
APPLE_CLIENT_IDS=com.enthusiastdev.wordhabit,com.enthusiastdev.wordhabit.stg
GOOGLE_CLIENT_IDS=000000000000-example.apps.googleusercontent.com

# ── Queues ──────────────────────────────────────────────────────────

# REDIS_URL wins when set; the host/port pair is the local fallback.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Mail ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_example
MAIL_FROM=WordHabit <hello@wordhabit.app>

# ── Vocabulary ingestion ────────────────────────────────────────────

# Billed per call. An exhausted quota is detected and surfaced rather
# than retried, so a spent account fails the batch instead of looping.
OPENAI_API_KEY=sk-example
OPENAI_VOCABULARY_MODEL=

# ── Notifications ───────────────────────────────────────────────────

# Either the service account JSON inline, or a path to it. Fly gets the
# inline form, since there is no file to mount.
FIREBASE_PROJECT_ID=wordhabit-example
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ── Subscriptions ───────────────────────────────────────────────────

# The whole authentication of the RevenueCat webhook. RevenueCat signs
# nothing: it echoes back the Authorization header configured in its
# dashboard, and the guard compares this value to it in constant time.
#
# Copy it VERBATIM, including the "Bearer " prefix if the dashboard has
# one — the comparison is on the entire header, so a prefix on one side
# only rejects every call with no explanation.
#
# Unset, the guard refuses every webhook rather than letting them
# through. Use a different secret per environment: the sandbox webhook
# points at a developer machine, and that secret gets seen.
REVENUECAT_WEBHOOK_SECRET=

# ── Observability ───────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
