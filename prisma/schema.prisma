// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEntry {
  id        String              @id @default(cuid())
  email     String              @unique
  source    String?
  status    WaitlistEntryStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status])
  @@map("waitlist_entries")
}

enum WaitlistEntryStatus {
  PENDING
  INVITED
  CONVERTED
  REJECTED
}

enum LanguageCode {
  EN
  ES
  FR
  DE
  IT
}

enum VocabularyWordStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WordDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  EXPRESSION
  OTHER
}

enum UserWordProgressStatus {
  NEW
  SEEN
  LEARNING
  MASTERED
  SKIPPED
}

enum AccountDeletionReason {
  TOO_MANY_NOTIFICATIONS
  LOST_MY_STREAK
  NOT_LEARNING_ENOUGH
  TOO_EXPENSIVE
  FOUND_BETTER
  OTHER
}

model VocabularyWord {
  id             String               @id @default(cuid())
  term           String
  normalizedTerm String
  targetLanguage LanguageCode
  difficulty     WordDifficulty
  partOfSpeech   PartOfSpeech
  status         VocabularyWordStatus @default(DRAFT)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  definitions          WordDefinition[]
  examples             WordExample[]
  pronunciations       WordPronunciation[]
  synonyms             WordSynonym[]
  antonyms             WordAntonym[]
  quizScenarios        WordQuizScenario[]
  themes               VocabularyWordTheme[]
  dailyWordAssignments DailyWordAssignment[]
  userWordProgresses   UserWordProgress[]
  userWordReviewEvents UserWordReviewEvent[]
  favoriteWords        FavoriteWord[]
  quizResults          QuizResult[]

  @@unique([normalizedTerm, targetLanguage])
  @@index([targetLanguage, difficulty])
  @@index([normalizedTerm])
  @@map("vocabulary_words")
}

model WordDefinition {
  id                  String       @id @default(cuid())
  wordId              String
  explanationLanguage LanguageCode
  text                String
  register            String?
  createdAt           DateTime     @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@index([explanationLanguage])
  @@map("word_definitions")
}

model WordExample {
  id                  String        @id @default(cuid())
  wordId              String
  sentence            String
  translation         String?
  translationLanguage LanguageCode?
  createdAt           DateTime      @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("word_examples")
}

model WordPronunciation {
  id        String   @id @default(cuid())
  wordId    String
  phonetic  String?
  audioUrl  String?
  provider  String?
  createdAt DateTime @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("word_pronunciations")
}

model WordSynonym {
  id        String   @id @default(cuid())
  wordId    String
  value     String
  createdAt DateTime @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("word_synonyms")
}

/// Mirrors WordSynonym: the speed round asks for an opposite, and a
/// distractor drawn from the corpus beats one invented at question time.
model WordAntonym {
  id        String   @id @default(cuid())
  wordId    String
  value     String
  createdAt DateTime @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("word_antonyms")
}

/// One Real-World Situations question, written at ingestion.
///
/// The only quiz mode that cannot be built from a query: its wrong
/// answers are plausible *misuses of the word itself* — "I need to
/// serendipity this room" — not other words' definitions. That is what
/// the mode teaches, and what makes it worth generating ahead of time
/// rather than paying for on every session.
model WordQuizScenario {
  id          String       @id @default(cuid())
  wordId      String
  /// The language the scenario is written in. Like WordDefinition, a
  /// French learner must not be handed English situations.
  language    LanguageCode
  /// The everyday moment the question is set in.
  situation   String
  question    String
  /// Stored apart from the distractors rather than by index: an index
  /// survives a reordering and quietly starts pointing at a wrong
  /// answer.
  correct     String
  /// Wrong answers, ordered as written. The client shuffles.
  distractors String[]
  createdAt   DateTime     @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, language])
  @@map("word_quiz_scenarios")
}

model Theme {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vocabularyWords           VocabularyWordTheme[]
  userLearningProfileThemes UserLearningProfileTheme[]

  @@index([slug])
  @@map("themes")
}

model VocabularyWordTheme {
  wordId  String
  themeId String

  word  VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  theme Theme          @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([wordId, themeId])
  @@index([themeId])
  @@map("vocabulary_word_themes")
}

model User {
  id              String                 @id @default(cuid())
  email           String                 @unique
  name            String
  createdAt       DateTime               @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime               @updatedAt
  password        String?
  emailVerifiedAt DateTime?
  deletionReason  AccountDeletionReason?
  passwordVersion Int                    @default(1)

  userLearningProfiles    UserLearningProfile[]
  dailyWordAssignments    DailyWordAssignment[]
  userWordProgresses      UserWordProgress[]
  userWordReviewEvents    UserWordReviewEvent[]
  userLearningStreaks     UserLearningStreak[]
  favoriteWords           FavoriteWord[]
  emailVerificationCodes  EmailVerificationCode[]
  devices                 Device[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries  NotificationDelivery[]
  refreshTokens           RefreshToken[]
  emailChangeRequests     EmailChangeRequest[]
  badges                  UserBadge[]
  identities              UserIdentity[]
  quizResults             QuizResult[]

  /// Current entitlement, written only by the RevenueCat webhook. The
  /// store is the source of truth; this is the server's cached answer to
  /// "may this user reach a Pro capability", and it is what guards read.
  subscriptionTier      SubscriptionTier @default(FREE)
  /// When the current period ends. Kept alongside the tier rather than
  /// derived from it: a cancelled subscription stays PRO until it lapses,
  /// and the two facts answer different questions.
  subscriptionExpiresAt DateTime?
  /// Which store billed it, for support and for reading revenue reports.
  subscriptionStore     String?
  /// When the store event behind the three fields above happened — not
  /// when we wrote them. A retried webhook can arrive after a newer one
  /// (RevenueCat retries for hours), and replaying an old cancellation
  /// over a live entitlement would revoke a paying learner.
  subscriptionEventAt   DateTime?

  @@index([deletedAt])
  @@index([email])
  @@map("users")
}

/// One issued refresh token.
///
/// The token itself is never stored — only its SHA-256 digest, so a
/// dump of this table hands an attacker nothing usable. SHA-256 rather
/// than bcrypt because the value is 256 bits of randomness, not a
/// password: there is nothing to brute-force, and lookup has to be an
/// indexed equality match.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  /// Set the moment the token is used, logged out, or caught in a
  /// replay. A revoked row is kept, not deleted: presenting it again is
  /// exactly the signal reuse detection runs on.
  revokedAt DateTime?

  /// The token issued in its place, for walking a rotation chain.
  replacedByTokenId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// An email change waiting on proof that the new address is reachable.
///
/// The address lives here, never on `User`, until the code sent to it
/// comes back: a typo or a stolen session would otherwise lock the
/// account behind an address nobody can read.
model EmailChangeRequest {
  id         String    @id @default(cuid())
  userId     String
  newEmail   String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_requests")
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}

model UserLearningProfile {
  id                String          @id @default(cuid())
  userId            String
  isActive          Boolean         @default(true)
  interfaceLanguage LanguageCode
  targetLanguage    LanguageCode
  difficulty        WordDifficulty?

  /// The one profile a downgrade keeps writable, and the only one that
  /// cannot be deleted. Distinct from `isActive`, which is merely what
  /// the learner is looking at right now.
  isMain Boolean @default(false)

  /// When this profile's word is announced. Per profile so two words
  /// never land together; a partial unique index below keeps the slots
  /// exclusive within a user.
  reminderSlot NotificationSlot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  themes                 UserLearningProfileTheme[]
  dailyWordAssignments   DailyWordAssignment[]
  notificationDeliveries NotificationDelivery[]

  // One profile per user *per language*. Which of them is current is
  // `isActive`, guarded by a partial unique index the migration creates
  // by hand — Prisma has no syntax for `WHERE "isActive"`.
  @@unique([userId, targetLanguage])
  @@index([targetLanguage])
  @@map("user_learning_profiles")
}

model UserLearningProfileTheme {
  userLearningProfileId String
  themeId               String

  userLearningProfile UserLearningProfile @relation(fields: [userLearningProfileId], references: [id], onDelete: Cascade)
  theme               Theme               @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([userLearningProfileId, themeId])
  @@index([themeId])
  @@map("user_learning_profile_themes")
}

model DailyWordAssignment {
  id                    String   @id @default(cuid())
  userId                String
  userLearningProfileId String
  wordId                String
  assignedFor           DateTime
  createdAt             DateTime @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userLearningProfile UserLearningProfile @relation(fields: [userLearningProfileId], references: [id], onDelete: Cascade)
  word                VocabularyWord      @relation(fields: [wordId], references: [id], onDelete: Cascade)

  // Per profile, not per user: Pro learns one word per language per day,
  // and keying this on the user made that impossible by construction.
  @@unique([userLearningProfileId, assignedFor])
  @@index([userId])
  @@index([wordId])
  @@map("daily_word_assignments")
}

model UserWordProgress {
  id           String                 @id @default(cuid())
  userId       String
  wordId       String
  status       UserWordProgressStatus @default(NEW)
  masteryLevel Int                    @default(0)
  reviewCount  Int                    @default(0)

  seenAt         DateTime?
  lastReviewedAt DateTime?
  /// The day the word comes back, `yyyy-MM-dd`. A calendar day, not an
  /// instant: "review in 3 days" must land at the start of the learner's
  /// third day, wherever they are, not at the clock time they happened
  /// to answer.
  nextReviewOn   String?   @db.VarChar(10)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  // Review queue: filters on user + status, then reads in due order.
  // Carrying nextReviewOn lets the sort come from the index instead of
  // a sort over every word the user owns.
  @@index([userId, status, nextReviewOn])
  // Library: one user's words, newest first, paginated by cursor.
  @@index([userId, updatedAt])
  @@map("user_word_progress")
}

/// Append-only log of every review a user submits.
///
/// UserWordProgress keeps only `lastReviewedAt`, which is overwritten on
/// each review, so per-day history cannot be reconstructed from it. This
/// table is what the progress heatmap and the activity chart aggregate.
/// Rows are never updated — one row per review.
model UserWordReviewEvent {
  id      String  @id @default(cuid())
  userId  String
  wordId  String
  correct Boolean

  /// Mastery before and after this review.
  ///
  /// Stored rather than re-derived: the interval table is the only thing
  /// that knows what a correct answer was worth on the day, and it will
  /// change. A card that says "60 → 75%" has to be reading history, not
  /// replaying today's rules against yesterday's answer.
  masteryBefore Int @default(0)
  masteryAfter  Int @default(0)

  /// The calendar day the user experienced, `yyyy-MM-dd`, supplied by the
  /// client that submitted the review.
  ///
  /// Stored as text on purpose. ISO-8601 dates sort chronologically as
  /// strings, so every activity query is a plain string range — no
  /// timezone offsets, no instant arithmetic, no date_trunc. The day is
  /// recorded once, by the only party that knows it, and read back
  /// verbatim; that also makes it immune to DST and to the user changing
  /// timezone later.
  localDate String @db.VarChar(10)

  /// The precise instant, kept for ordering and audit — never for
  /// grouping by day.
  reviewedAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  // Serves every activity range scan directly.
  @@index([userId, localDate])
  @@index([wordId])
  @@map("user_word_review_events")
}

model UserLearningStreak {
  id            String @id @default(cuid())
  userId        String @unique
  currentStreak Int    @default(0)
  longestStreak Int    @default(0)

  /// The last calendar day the user was active, `yyyy-MM-dd`, as reported
  /// by their device.
  ///
  /// A date rather than an instant: "did they show up today, yesterday, or
  /// break the chain" is a question about the user's calendar, and deriving
  /// it from a timestamp in the server's timezone let an evening review
  /// count as tomorrow — inflating or breaking streaks for anyone far from
  /// UTC. Matches UserWordReviewEvent.localDate.
  lastActivityLocalDate String? @db.VarChar(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_learning_streaks")
}

model FavoriteWord {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([wordId])
  @@map("favorite_words")
}

/// Every badge the app can award.
///
/// A closed enum rather than free text: the app draws each badge with
/// its own shape, colour and copy, so a code it does not know is a blank
/// tile. Adding one is a migration on purpose.
enum BadgeCode {
  STREAK_30
  STREAK_50
  STREAK_150
  STREAK_200
  HABIT_MASTER
  COLLECTOR_50
  COLLECTOR_100
  COLLECTOR_150
  COLLECTOR_200
  WORD_EXPLORER
  FLUENT_LEARNER
  BILINGUAL_PRO
  QUIZ_CHAMPION
}

/// One badge a user has earned, and when.
///
/// Stored rather than derived, unlike XP. A badge is an event, not a
/// sum: it has to survive the condition that produced it — a 150-day
/// badge outlives the streak that broke — and the date it was won is
/// not recoverable from today's data.
model UserBadge {
  id       String    @id @default(cuid())
  userId   String
  code     BadgeCode
  earnedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Awarding is idempotent: the evaluator runs after every write that
  /// could unlock something, and leans on this to stay a no-op.
  @@unique([userId, code])
  /// The badges screen reads one user's, newest first.
  @@index([userId, earnedAt])
  @@map("user_badges")
}

enum NotificationChannel {
  DAILY_WORD
  STREAK_RISK
}

enum NotificationSlot {
  MORNING
  MIDDAY
  EVENING
}

enum Platform {
  IOS
  ANDROID
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  slot      NotificationSlot?
  enabled   Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  timeZone   String
  platform   Platform
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timeZone])
  // Standalone: the sweep starts by listing the distinct zones in use.
  @@index([timeZone])
  @@map("devices")
}

model NotificationDelivery {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  localDate DateTime            @db.Date
  sentAt    DateTime            @default(now())
  createdAt DateTime            @default(now())

  /// Set on per-profile channels: the daily word is announced once per
  /// language. Null on channels that speak to the person, like the
  /// streak reminder.
  userLearningProfileId String?

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userLearningProfile UserLearningProfile? @relation(fields: [userLearningProfileId], references: [id], onDelete: Cascade)

  // Uniqueness is two hand-written partial indexes, one per shape: a
  // plain composite would let NULL profiles duplicate, since Postgres
  // treats NULLs as distinct.
  @@index([userId, channel, localDate])
  @@index([userLearningProfileId])
  @@map("notification_deliveries")
}

/// One sign-in method belonging to an account.
///
/// A row per provider rather than columns on User: an account may carry
/// Apple, Google and a password at once, and a third provider costs a
/// row instead of a migration.
model UserIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  /// The provider's own subject id. Stable for the life of the account,
  /// and the only thing that survives a user changing their email.
  providerUserId String
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// One finished quiz round.
///
/// The durable record XP and QUIZ_CHAMPION derive from — the same
/// pattern as UserWordReviewEvent for recalls. "Perfect" is computed
/// (correctCount = questionCount), never stored: a flag could disagree
/// with the counts it summarises.
model QuizResult {
  id            String   @id @default(cuid())
  userId        String
  wordId        String
  mode          QuizMode
  correctCount  Int
  questionCount Int
  /// The calendar day the user experienced, `yyyy-MM-dd`, supplied by
  /// the client — the same convention as review events.
  localDate     String
  createdAt     DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
  @@index([userId, mode])
  @@map("quiz_results")
}

enum SubscriptionTier {
  FREE
  PRO
}

enum QuizMode {
  MASTERY
  REALWORLD
  SPEED
}

enum AuthProvider {
  APPLE
  GOOGLE
}
