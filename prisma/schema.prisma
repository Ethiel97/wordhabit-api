// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEntry {
  id        String              @id @default(cuid())
  email     String              @unique
  source    String?
  status    WaitlistEntryStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([email])
  @@index([status])
  @@map("waitlist_entries")
}

enum WaitlistEntryStatus {
  PENDING
  INVITED
  CONVERTED
  REJECTED
}

enum LanguageCode {
  EN
  ES
  FR
}

enum VocabularyWordStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WordDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  EXPRESSION
  OTHER
}

model VocabularyWord {
  id             String               @id @default(cuid())
  term           String
  normalizedTerm String
  targetLanguage LanguageCode
  difficulty     WordDifficulty
  partOfSpeech   PartOfSpeech
  status         VocabularyWordStatus @default(DRAFT)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  definitions    WordDefinition[]
  examples       WordExample[]
  pronunciations WordPronunciation[]
  synonyms       WordSynonym[]

  @@index([targetLanguage])
  @@unique([normalizedTerm, targetLanguage])
  @@map("vocabulary_words")
}

model WordDefinition {
  id                  String       @id @default(cuid())
  wordId              String
  explanationLanguage LanguageCode
  text                String
  register            String?
  createdAt           DateTime     @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@index([explanationLanguage])
  @@map("word_definitions")
}

model WordExample {
  id                  String        @id @default(cuid())
  wordId              String
  sentence            String
  translation         String?
  translationLanguage LanguageCode?
  createdAt           DateTime      @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("word_examples")
}

model WordPronunciation {
  id        String   @id @default(cuid())
  wordId    String
  phonetic  String?
  audioUrl  String?
  provider  String?
  createdAt DateTime @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("word_pronunciations")
}

model WordSynonym {
  id        String   @id @default(cuid())
  wordId    String
  value     String
  createdAt DateTime @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("word_synonyms")
}
